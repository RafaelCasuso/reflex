{
  "version": 1,
  "cases": [
    {
      "id": "aws-access-key-env",
      "kind": "aws-access-key",
      "template": "export AWS_ACCESS_KEY_ID={secret}\nexport AWS_REGION=eu-west-1"
    },
    {
      "id": "aws-access-key-in-command",
      "kind": "aws-access-key",
      "template": "aws s3 ls --profile default # key {secret}"
    },
    {
      "id": "aws-secret-key-env",
      "kind": "aws-secret-key",
      "template": "AWS_SECRET_ACCESS_KEY={secret}"
    },
    {
      "id": "aws-secret-key-json",
      "kind": "aws-secret-key",
      "template": "{\"aws_secret_access_key\": \"{secret}\"}"
    },
    {
      "id": "github-token-curl",
      "kind": "github-token",
      "template": "curl -H 'Authorization: token {secret}' https://api.github.com/user"
    },
    {
      "id": "github-pat-env",
      "kind": "github-token",
      "template": "GITHUB_TOKEN={secret}"
    },
    {
      "id": "slack-token-json",
      "kind": "slack-token",
      "template": "{\"token\": \"{secret}\", \"channel\": \"C123\"}"
    },
    {
      "id": "stripe-live-key",
      "kind": "stripe-key",
      "template": "STRIPE_SECRET_KEY={secret}"
    },
    {
      "id": "stripe-key-in-url",
      "kind": "stripe-key",
      "template": "curl https://api.stripe.com/v1/charges -u {secret}:"
    },
    {
      "id": "google-api-key-query",
      "kind": "google-api-key",
      "template": "https://maps.googleapis.com/maps/api/geocode/json?address=x&key={secret}"
    },
    {
      "id": "openai-key-env",
      "kind": "openai-key",
      "template": "OPENAI_API_KEY={secret}"
    },
    {
      "id": "anthropic-key-env",
      "kind": "anthropic-key",
      "template": "ANTHROPIC_API_KEY={secret}"
    },
    {
      "id": "typesafe-key-env",
      "kind": "typesafe-key",
      "template": "TYPESAFE_API_KEY={secret}"
    },
    {
      "id": "jwt-bearer",
      "kind": "jwt",
      "template": "Authorization: Bearer {secret}"
    },
    {
      "id": "jwt-cookie",
      "kind": "jwt",
      "template": "Cookie: session={secret}; theme=dark"
    },
    {
      "id": "private-key-file",
      "kind": "private-key",
      "template": "{secret}"
    },
    {
      "id": "private-key-in-heredoc",
      "kind": "private-key",
      "template": "cat > id_ed25519 <<'EOF'\n{secret}\nEOF"
    },
    {
      "id": "authorization-basic",
      "kind": "authorization-header",
      "template": "curl -H \"Authorization: Basic {secret}\" https://example.test/"
    },
    {
      "id": "url-credentials-git",
      "kind": "url-credentials",
      "template": "git clone https://deploy:{secret}@github.com/acme/webapp.git"
    },
    {
      "id": "url-credentials-db",
      "kind": "url-credentials",
      "template": "DATABASE_URL=postgres://app:{secret}@db.internal:5432/app"
    },
    {
      "id": "assignment-password-flag",
      "kind": "assignment",
      "template": "mysql -u root --password={secret} app"
    },
    {
      "id": "assignment-json-secret",
      "kind": "assignment",
      "template": "{\"client_secret\": \"{secret}\", \"grant_type\": \"client_credentials\"}"
    },
    {
      "id": "assignment-env-token",
      "kind": "assignment",
      "template": "NPM_TOKEN={secret}"
    }
  ]
}
