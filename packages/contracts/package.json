{
  "name": "@reflex-control/contracts",
  "version": "0.0.0",
  "description": "Canonical public/internal schemas. The single source of truth for REFLEX contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelCasuso/reflex.git",
    "directory": "packages/contracts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
