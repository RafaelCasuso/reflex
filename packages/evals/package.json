{
  "name": "@reflex-control/evals",
  "version": "0.0.0",
  "description": "Regression corpus and autonomy/safety evaluation harness.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
