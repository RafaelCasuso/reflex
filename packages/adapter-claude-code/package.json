{
  "name": "@reflex/adapter-claude-code",
  "version": "0.0.0",
  "description": "Claude Code host translation only.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "default": "./dist/hook.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelCasuso/reflex.git",
    "directory": "packages/adapter-claude-code"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@reflex/contracts": "workspace:*",
    "@reflex/telemetry": "workspace:*",
    "jsonc-parser": "^3.3.1"
  }
}
