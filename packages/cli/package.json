{
  "name": "@reflex/cli",
  "version": "0.0.0",
  "description": "Installation, detection, configuration and diagnostics (rfx).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "rfx": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelCasuso/reflex.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@reflex/adapter-claude-code": "workspace:*",
    "@reflex/adapter-codex": "workspace:*",
    "@reflex/contracts": "workspace:*",
    "@reflex/core": "workspace:*",
    "@reflex/decision-gateway": "workspace:*",
    "@reflex/policy-engine": "workspace:*",
    "@reflex/semantic-provider": "workspace:*",
    "@reflex/telemetry": "workspace:*"
  }
}
