{
  "name": "@reflex/core",
  "version": "0.0.0",
  "description": "Decision orchestration and domain logic.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelCasuso/reflex.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@reflex/contracts": "workspace:*",
    "@reflex/policy-engine": "workspace:*",
    "@reflex/semantic-provider": "workspace:*"
  }
}
