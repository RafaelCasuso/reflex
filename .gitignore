# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# tooling caches
.turbo/
coverage/
# ~/.npmrc may set a relative `cache=.npm-cache`; never commit it
.npm-cache/
# pnpm puts its store here when the project is on another volume than the
# home directory (a bind-mounted container, for one)
.pnpm-store/

# local environment — never commit secrets
.env
.env.*
!.env.example

# logs
*.log

# python (rdm/, ADR-016 §5)
rdm/.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
rdm/data/
