{
  "name": "reflex",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "description": "REFLEX \u2014 the autonomy control layer for AI agents.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint lint:root format:check",
    "typecheck": "turbo run typecheck typecheck:root",
    "test": "turbo run test test:root",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint --max-warnings 0 eslint.config.mjs vitest.config.ts tests site/src",
    "typecheck:root": "tsc -p tsconfig.json",
    "test:root": "vitest run",
    "mutation": "node tools/mutate.mjs",
    "site:build": "node site/src/build.mjs",
    "site:check": "node site/src/check-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
